{
 "scripts": [
  {
   "id": "scr_blog_post",
   "name": "博客发文章（填好等确认）",
   "description": "填好标题和正文，截图后停下等确认，再点发布并记下链接。",
   "start_url": "https://blog.example.com/editor",
   "profile": "发帖号",
   "params": [
    {
     "name": "title",
     "type": "string",
     "required": true
    },
    {
     "name": "body_md",
     "type": "text"
    }
   ],
   "graph": {
    "nodes": [
     {
      "id": "n1",
      "type": "navigate",
      "pos": [
       0,
       0
      ],
      "title": "打开写文章页",
      "url": "https://blog.example.com/editor"
     },
     {
      "id": "n2",
      "type": "wait",
      "pos": [
       300,
       0
      ],
      "title": "等编辑器出现",
      "wait": "element",
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "textbox",
         "name": "文章标题"
        },
        {
         "kind": "css",
         "value": "input.title"
        }
       ]
      }
     },
     {
      "id": "n3",
      "type": "type",
      "pos": [
       600,
       0
      ],
      "title": "填标题",
      "value": "${title}",
      "clear": true,
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "textbox",
         "name": "文章标题"
        },
        {
         "kind": "placeholder",
         "value": "请输入文章标题"
        },
        {
         "kind": "css",
         "value": "input.title"
        }
       ]
      }
     },
     {
      "id": "n4",
      "type": "type",
      "pos": [
       900,
       0
      ],
      "title": "填正文",
      "value": "${body_md}",
      "target": {
       "locators": [
        {
         "kind": "testid",
         "value": "editor-body"
        },
        {
         "kind": "css",
         "value": ".editor [contenteditable]"
        }
       ]
      }
     },
     {
      "id": "n5",
      "type": "screenshot",
      "pos": [
       0,
       170
      ],
      "title": "截图留档"
     },
     {
      "id": "n6",
      "type": "confirm",
      "pos": [
       300,
       170
      ],
      "title": "确认发布",
      "message": "标题和正文已填好，确认发布吗？"
     },
     {
      "id": "n7",
      "type": "click",
      "pos": [
       600,
       170
      ],
      "title": "点发布",
      "button": "left",
      "count": 1,
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "button",
         "name": "发布"
        },
        {
         "kind": "text",
         "value": "发布文章"
        }
       ]
      }
     },
     {
      "id": "n8",
      "type": "extract",
      "pos": [
       900,
       170
      ],
      "title": "记下文章链接",
      "what": "attribute",
      "attr": "href",
      "into": "post_url",
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "link",
         "name": "查看文章"
        }
       ]
      }
     },
     {
      "id": "n9",
      "type": "note",
      "pos": [
       300,
       300
      ],
      "note": "到「确认发布」会停下，等运行的人或 agent 同意。"
     }
    ],
    "edges": [
     [
      "n1",
      "n2"
     ],
     [
      "n2",
      "n3"
     ],
     [
      "n3",
      "n4"
     ],
     [
      "n4",
      "n5"
     ],
     [
      "n5",
      "n6"
     ],
     [
      "n6",
      "n7",
      "ok"
     ],
     [
      "n7",
      "n8"
     ]
    ]
   },
   "on_error": "stop",
   "source": "record"
  },
  {
   "id": "scr_price_list",
   "name": "抓取商品价格",
   "description": "按关键词搜索，读出商品表格。",
   "start_url": "https://shop.example.com/",
   "profile": "工作号",
   "params": [
    {
     "name": "keyword",
     "type": "string",
     "required": true,
     "default": "机械键盘"
    }
   ],
   "graph": {
    "nodes": [
     {
      "id": "p1",
      "type": "navigate",
      "pos": [
       0,
       0
      ],
      "title": "打开商品列表",
      "url": "https://shop.example.com/list?q=${keyword}"
     },
     {
      "id": "p2",
      "type": "extract",
      "pos": [
       300,
       0
      ],
      "title": "读取商品表",
      "what": "table",
      "into": "rows",
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "table",
         "name": "商品"
        },
        {
         "kind": "css",
         "value": "table.products"
        }
       ]
      }
     },
     {
      "id": "p3",
      "type": "branch",
      "pos": [
       600,
       0
      ],
      "title": "有下一页吗",
      "check": "visible",
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "link",
         "name": "下一页"
        }
       ]
      }
     },
     {
      "id": "p4",
      "type": "click",
      "pos": [
       900,
       0
      ],
      "title": "翻到下一页",
      "button": "left",
      "count": 1,
      "target": {
       "locators": [
        {
         "kind": "role",
         "role": "link",
         "name": "下一页"
        }
       ]
      }
     },
     {
      "id": "p5",
      "type": "extract",
      "pos": [
       900,
       104
      ],
      "title": "读取页码",
      "what": "text",
      "into": "page",
      "target": {
       "locators": [
        {
         "kind": "css",
         "value": ".pager .current"
        }
       ]
      }
     }
    ],
    "edges": [
     [
      "p1",
      "p2"
     ],
     [
      "p2",
      "p3"
     ],
     [
      "p3",
      "p4",
      "true"
     ],
     [
      "p3",
      "p5",
      "false"
     ]
    ]
   },
   "on_error": "retry:2",
   "source": "manual"
  }
 ],
